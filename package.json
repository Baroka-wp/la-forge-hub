{
  "name": "instii-lms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "start": "node node_modules/prisma/build/index.js migrate deploy && node scripts/backfill-lms.mjs && node server/prod.mjs",
    "dev": "node server/dev.mjs",
    "dev:kill": "bash scripts/kill-dev-ports.sh",
    "dev:vite": "node node_modules/vite/bin/vite.js",
    "dev:vercel": "vercel dev",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/vite/bin/vite.js build",
    "test": "node node_modules/prisma/build/index.js generate && node --test spec/tests/*.test.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "admin:promote": "node scripts/promote-admin.mjs",
    "deploy:coolify": "node scripts/coolify-deploy.mjs",
    "db:seed:attestations": "node prisma/seed-attestations.mjs",
    "db:import:attestations": "node scripts/import-attestations.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.3.0",
    "vercel": "^39.0.0",
    "vite": "^6.2.0"
  }
}
