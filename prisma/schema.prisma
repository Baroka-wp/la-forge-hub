generator client {
  provider = "prisma-client-js"
}

// Neon : URL avec pooler pour l’app ; pour `prisma migrate`, ajoutez directUrl (URL non poolée) — voir doc Neon + Prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  learner
  admin
}

enum Segment {
  COLLEGE
  LYCEE
}

enum Discipline {
  PYTHON
  MATH
  ML
  DEEP
  NLP
  SOFT
}

enum LessonKind {
  VIDEO
  READING
  EXERCISE
  QUIZ
  PROJECT
}

enum AttemptStatus {
  PASSED
  FAILED
  PENDING_REVIEW
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(learner)
  authVersion  Int      @default(0) @map("auth_version")
  /** Accepte les e-mails d’annonces La Forge Hub (formation, webinaires). */
  marketingOptIn Boolean @default(false) @map("marketing_opt_in")
  segment        Segment?
  birthYear      Int?     @map("birth_year")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  enrollments          Enrollment[]
  lessonProgress       LessonProgress[]
  posts                CommunityPost[]
  webinarRegistrations WebinarRegistration[]
  passwordResetTokens  PasswordResetToken[]
  attempts             Attempt[]
  projectSubmissions   ProjectSubmission[] @relation("ProjectAuthor")
  reviewedSubmissions  ProjectSubmission[] @relation("ProjectReviewer")
  badges               UserBadge[]

  /* EMONOS */
  teamMemberships      TeamMember[]
  ownedProjects        TaskProject[]       @relation("ProjectOwner")
  projectMemberships   TaskProjectMember[]
  ownedTasks           Task[]              @relation("TaskOwner")
  taskEvents           TaskEvent[]
  workflowRunLogs      WorkflowRunLog[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum WebinarKind {
  ARCHIVE
  EVENT
}

enum WebinarLocation {
  ONLINE
  ONSITE
}

/** Replay (ARCHIVE) ou session live à venir (EVENT) */
model Webinar {
  id           String           @id @default(uuid())
  kind         WebinarKind
  title        String
  description  String
  tag          String
  recordingUrl String?          @map("recording_url")
  startsAt     DateTime?        @map("starts_at")
  locationType WebinarLocation? @map("location_type")
  onlineLink   String?          @map("online_link")
  venue        String?
  bannerUrl    String?          @map("banner_url")
  published    Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  registrations WebinarRegistration[]
  replayViews   WebinarReplayView[]

  @@index([kind, startsAt])
  @@index([published])
  @@map("webinars")
}

model WebinarRegistration {
  id           String   @id @default(uuid())
  webinarId    String   @map("webinar_id")
  /** Compte plateforme ; null = inscription invité (email / téléphone / nom). */
  userId       String?  @map("user_id")
  /** E-mail normalisé (minuscule, trim) — clé de dédoublonnage par webinaire. */
  emailKey     String   @map("email_key")
  /** Téléphone WhatsApp (invités) ; optionnel pour comptes liés. */
  guestPhone   String?  @map("guest_phone")
  /** Nom complet (invités). */
  guestName    String?  @map("guest_name")
  /** Consentement e-mails annonces La Forge Hub au moment de l’inscription. */
  marketingOptIn Boolean @default(false) @map("marketing_opt_in")
  registeredAt DateTime @default(now()) @map("registered_at")

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([webinarId, emailKey])
  @@index([webinarId])
  @@map("webinar_registrations")
}

/** Vues uniques d’un replay (comptage interne, anonyme, 1 par navigateur). */
model WebinarReplayView {
  id        String   @id @default(uuid())
  webinarId String   @map("webinar_id")
  viewerKey String   @map("viewer_key")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([webinarId, viewerKey])
  @@index([webinarId, viewedAt(sort: Desc)])
  @@map("webinar_replay_views")
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  courseSlug String   @default("formation-ia") @map("course_slug")
  trackId    String?  @map("track_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@unique([userId, courseSlug])
  @@index([trackId])
  @@map("enrollments")
}

/** Contacts dédupliqués par e-mail (CRM / annonces Brevo). */
model MarketingContact {
  id             String   @id @default(uuid())
  emailKey       String   @unique @map("email_key")
  displayName    String?  @map("display_name")
  phone          String?
  marketingOptIn Boolean  @default(false) @map("marketing_opt_in")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([marketingOptIn])
  @@map("marketing_contacts")
}

model LessonProgress {
  userId          String   @map("user_id")
  lessonId        String   @map("lesson_id")
  completed       Boolean  @default(false)
  lastPositionSec Int      @default(0) @map("last_position_sec")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

model CommunityPost {
  id        String   @id @default(uuid())
  lessonId  String   @map("lesson_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent CommunityPost? @relation("PostThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityPost[] @relation("PostThread")

  @@index([lessonId, createdAt(sort: Desc)])
  @@map("community_posts")
}

/** Catalogue leçons (vidéos + lien Colab / corrigé) — alimenté par seed ou API admin */
model Lesson {
  lessonId    String    @id @map("lesson_id")
  courseSlug  String    @default("formation-ia") @map("course_slug")
  position    Int
  title       String
  /** Résumé affiché dans le menu des leçons et le catalogue (optionnel) */
  description String?   @db.Text @map("description")
  moduleId    String?   @map("module_id")
  kind        LessonKind @default(VIDEO)
  youtubeId   String?   @map("youtube_id")
  bodyMarkdown String?  @db.Text @map("body_markdown")
  durationMin Int?      @map("duration_min")
  published   Boolean   @default(true)
  tag         String
  collabUrl   String?   @map("collab_url")
  recordedAt  DateTime? @map("recorded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  module        Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  exercises     Exercise[]
  quizQuestions QuizQuestion[]
  attempts      Attempt[]
  projects      Project[]

  @@unique([courseSlug, position])
  @@index([courseSlug])
  @@index([moduleId])
  @@map("lessons")
}

model Track {
  id                  String     @id @default(uuid())
  slug                String     @unique
  title               String
  summary             String?    @db.Text
  discipline          Discipline
  segment             Segment
  position            Int
  published           Boolean    @default(false)
  prerequisiteTrackId String?    @map("prerequisite_track_id")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  prerequisite Track?       @relation("TrackPrerequisite", fields: [prerequisiteTrackId], references: [id], onDelete: SetNull)
  dependents   Track[]      @relation("TrackPrerequisite")
  modules      Module[]
  enrollments  Enrollment[]
  projects     Project[]

  @@index([segment, discipline, published])
  @@map("tracks")
}

model Module {
  id        String   @id @default(uuid())
  trackId   String   @map("track_id")
  title     String
  summary   String?  @db.Text
  position  Int
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([trackId, position])
  @@map("modules")
}

model Exercise {
  id           String   @id @default(uuid())
  lessonId     String   @map("lesson_id")
  position     Int
  prompt       String   @db.Text
  starterCode  String?  @db.Text @map("starter_code")
  solutionCode String?  @db.Text @map("solution_code")
  tests        Json
  hints        Json?
  points       Int      @default(10)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lesson  Lesson    @relation(fields: [lessonId], references: [lessonId], onDelete: Cascade)
  attempts Attempt[]

  @@unique([lessonId, position])
  @@map("exercises")
}

model QuizQuestion {
  id               String   @id @default(uuid())
  lessonId         String   @map("lesson_id")
  position         Int
  prompt           String   @db.Text
  choices          Json
  correctChoiceIds Json     @map("correct_choice_ids")
  explanation      String?  @db.Text
  points           Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [lessonId], onDelete: Cascade)

  @@unique([lessonId, position])
  @@map("quiz_questions")
}

model Attempt {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  lessonId   String        @map("lesson_id")
  exerciseId String?       @map("exercise_id")
  payload    Json
  score      Int
  maxScore   Int           @map("max_score")
  status     AttemptStatus
  feedback   Json?
  createdAt  DateTime      @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson    @relation(fields: [lessonId], references: [lessonId], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([userId, lessonId, createdAt(sort: Desc)])
  @@map("attempts")
}

model Project {
  id        String   @id @default(uuid())
  lessonId  String?  @map("lesson_id")
  trackId   String?  @map("track_id")
  title     String
  brief     String   @db.Text
  rubric    Json
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson      Lesson?             @relation(fields: [lessonId], references: [lessonId], onDelete: SetNull)
  track       Track?              @relation(fields: [trackId], references: [id], onDelete: SetNull)
  submissions ProjectSubmission[]

  @@index([trackId, published])
  @@map("projects")
}

model ProjectSubmission {
  id          String        @id @default(uuid())
  projectId   String        @map("project_id")
  userId      String        @map("user_id")
  repoUrl     String?       @map("repo_url")
  notebookUrl String?       @map("notebook_url")
  notes       String?       @db.Text
  status      AttemptStatus @default(PENDING_REVIEW)
  score       Int?
  reviewerId  String?       @map("reviewer_id")
  reviewedAt  DateTime?     @map("reviewed_at")
  submittedAt DateTime      @default(now()) @map("submitted_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User    @relation("ProjectAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ProjectReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, submittedAt(sort: Desc)])
  @@index([status, submittedAt])
  @@map("project_submissions")
}

model Badge {
  id          String   @id @default(uuid())
  code        String   @unique
  label       String
  description String   @db.Text
  rule        Json
  createdAt   DateTime @default(now()) @map("created_at")

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId    String   @map("user_id")
  badgeId   String   @map("badge_id")
  awardedAt DateTime @default(now()) @map("awarded_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

/* ---------- Attestations NOAI / Bootcamp IOAI ---------- */

enum CertificateKind {
  NOAI
  BOOTCAMP
}

/**
 * Participant NOAI 2026 (liste officielle, chargée par `db:seed:attestations`).
 * Les coordonnées sont vides au départ : elles sont renseignées, puis mises à jour,
 * à chaque demande d'attestation validée depuis /attestations.
 */
model Participant {
  id           String  @id @default(uuid())
  tableNumber  String  @unique @map("table_number")
  lastName     String  @map("last_name")
  firstName    String  @map("first_name")

  /** Renseignés par le participant lors de sa demande. */
  email        String?
  phone        String?
  /** Nom tel qu'il l'a saisi, conservé s'il diffère de la liste officielle. */
  declaredName String? @map("declared_name")

  requestCount  Int       @default(0) @map("request_count")
  firstRequestAt DateTime? @map("first_request_at")
  lastRequestAt  DateTime? @map("last_request_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  certificates Certificate[]

  @@index([email])
  @@map("participants")
}

/** Attestation nominative. Le PDF est rattaché après le seed, par script d'import. */
model Certificate {
  id            String          @id @default(uuid())
  participantId String          @map("participant_id")
  kind          CertificateKind
  fileName      String?         @map("file_name")
  pdf           Bytes?
  /** Aperçu JPEG page 1 (affichage fiable sur mobile, où l'iframe PDF échoue souvent). */
  previewImage  Bytes?          @map("preview_image")
  downloadCount Int             @default(0) @map("download_count")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  participant Participant           @relation(fields: [participantId], references: [id], onDelete: Cascade)
  downloads   CertificateDownload[]

  @@unique([participantId, kind])
  @@map("certificates")
}

/** Journal de toutes les demandes, y compris celles en échec (relance et support). */
model CertificateRequest {
  id           String   @id @default(uuid())
  tableNumber  String   @map("table_number")
  providedName String   @map("provided_name")
  email        String
  phone        String
  /** FOUND | NAME_MISMATCH | NOT_FOUND */
  outcome      String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tableNumber])
  @@index([outcome])
  @@map("certificate_requests")
}

/** Une ligne par téléchargement effectif (le compteur agrégé vit sur Certificate). */
model CertificateDownload {
  id            String   @id @default(uuid())
  certificateId String   @map("certificate_id")
  email         String?
  downloadedAt  DateTime @default(now()) @map("downloaded_at")

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@map("certificate_downloads")
}

/** Fenêtre de limitation des recherches, identifiée par une empreinte réseau anonyme. */
model CertificateRateLimit {
  ipHash          String   @id @map("ip_hash")
  windowStartedAt DateTime @default(now()) @map("window_started_at")
  requestCount    Int      @default(1) @map("request_count")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("certificate_rate_limits")
}

/**
 * ---------- EMONOS — Task Automation (gestion de projets & tâches) ----------
 */

/**
 * Type de projet proposé par l'assistant de création (« Type of project »).
 */
enum TaskProjectKind {
  SOFTWARE_DEV
  CALL_FOR_TENDER
  COMPANY_MGMT
}

/**
 * Mode de datation choisi à l'étape « Project dates » de l'assistant.
 */
enum ProjectDateMode {
  NONE
  FIXED
  AUTOMATIC
}

/**
 * Étape du cycle de vie d'un projet (regroupement « by stage »).
 */
enum ProjectStage {
  PRESALE
  EVALUATION
  DEVELOPMENT
  DELIVERY
  CLOSED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TaskState {
  TODO
  RUNNING
  STOPPED
  DONE
  CANCELLED
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

/**
 * Types de nœuds du concepteur de workflow.
 */
enum WorkflowNodeKind {
  START
  STEP
  DECISION
  SUBTASK
  END
}

enum WorkflowRunStatus {
  RUNNING
  DONE
  CANCELLED
}

/**
 * Équipe réutilisable, importable à l'étape « Team » de l'assistant.
 */
model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members  TeamMember[]
  projects TaskProject[]

  @@map("teams")
}

model TeamMember {
  teamId   String            @map("team_id")
  userId   String            @map("user_id")
  role     ProjectMemberRole @default(MEMBER)
  joinedAt DateTime          @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/**
 * Projet EMONOS. Arborescence via `parentId` (« Parent project » de l'assistant) ;
 * distinct du modèle `Project` du LMS, qui décrit un projet pédagogique.
 */
model TaskProject {
  id        String          @id @default(uuid())
  name      String
  notes     String?         @db.Text
  kind      TaskProjectKind @default(SOFTWARE_DEV)
  stage     ProjectStage    @default(PRESALE)
  priority  TaskPriority    @default(NORMAL)
  parentId  String?         @map("parent_id")
  ownerId   String?         @map("owner_id")
  teamId    String?         @map("team_id")
  dateMode  ProjectDateMode @default(NONE) @map("date_mode")
  startDate DateTime?       @map("start_date")
  dueDate   DateTime?       @map("due_date")
  timezone  String          @default("Europe/Paris")
  archived  Boolean         @default(false)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  parent   TaskProject?  @relation("ProjectTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TaskProject[] @relation("ProjectTree")
  owner    User?         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  team     Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)

  tasks     Task[]
  members   TaskProjectMember[]
  documents ProjectDocument[]
  runs      WorkflowRun[]

  @@index([parentId])
  @@index([archived, stage])
  @@index([ownerId])
  @@map("task_projects")
}

model TaskProjectMember {
  projectId String            @map("project_id")
  userId    String            @map("user_id")
  role      ProjectMemberRole @default(MEMBER)
  addedAt   DateTime          @default(now()) @map("added_at")

  project TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("task_project_members")
}

/**
 * Tâche d'un projet. `parentId` porte l'arborescence (bouton OPEN du deck :
 * ouvrir une tâche affiche ses tâches filles) et `path` le fil d'Ariane matérialisé
 * (« Sub Task of : /Development/Design »).
 */
model Task {
  id             String       @id @default(uuid())
  projectId      String       @map("project_id")
  parentId       String?      @map("parent_id")
  title          String
  description    String?      @db.Text
  path           String       @default("/")
  position       Int          @default(0)
  priority       TaskPriority @default(NORMAL)
  state          TaskState    @default(TODO)
  ownerId        String?      @map("owner_id")
  startDate      DateTime?    @map("start_date")
  dueDate        DateTime?    @map("due_date")
  plannedHours   Int?         @map("planned_hours")
  progress       Int          @default(0)
  archived       Boolean      @default(false)
  /**
   * Macro attachée à la propriété `event_dashboard` : affiche le bouton DASHBOARD.
   */
  eventDashboard String?      @map("event_dashboard")
  /**
   * Macro attachée à la propriété `event_configure` : affiche le bouton CONFIGURE.
   */
  eventConfigure String?      @map("event_configure")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  project  TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Task?       @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[]      @relation("TaskTree")
  owner    User?       @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  events  TaskEvent[]
  runLogs WorkflowRunLog[]

  @@index([projectId, parentId, archived])
  @@index([projectId, dueDate])
  @@index([projectId, priority, state])
  @@map("tasks")
}

/**
 * Journal des actions et macros exécutées sur une tâche (EDIT, ARCHIVE, macros custom).
 */
model TaskEvent {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  actorId   String?  @map("actor_id")
  action    String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt(sort: Desc)])
  @@map("task_events")
}

/**
 * Modèle de document réutilisable (onglet « Documents templates »).
 */
model DocumentTemplate {
  id           String           @id @default(uuid())
  name         String
  category     String           @default("general")
  projectKind  TaskProjectKind? @map("project_kind")
  description  String?          @db.Text
  bodyMarkdown String           @default("") @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  documents ProjectDocument[]

  @@unique([name, category])
  @@index([projectKind])
  @@map("document_templates")
}

/**
 * Document instancié depuis un modèle pour un projet donné.
 */
model ProjectDocument {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  templateId   String?  @map("template_id")
  title        String
  bodyMarkdown String   @default("") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project  TaskProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_documents")
}

/**
 * Définition de workflow éditée dans le concepteur.
 */
model Workflow {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?          @db.Text
  projectKind TaskProjectKind? @map("project_kind")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  nodes       WorkflowNode[]
  transitions WorkflowTransition[]
  runs        WorkflowRun[]

  @@map("workflows")
}

model WorkflowNode {
  id         String           @id @default(uuid())
  workflowId String           @map("workflow_id")
  key        String
  kind       WorkflowNodeKind @default(STEP)
  label      String
  x          Int              @default(0)
  y          Int              @default(0)
  /**
   * Paramètres de la macro (ex. gabarit de sous-tâche pour un nœud SUBTASK).
   */
  macro      Json?

  workflow Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outgoing WorkflowTransition[] @relation("TransitionFrom")
  incoming WorkflowTransition[] @relation("TransitionTo")
  runs     WorkflowRun[]
  runLogs  WorkflowRunLog[]

  @@unique([workflowId, key])
  @@map("workflow_nodes")
}

model WorkflowTransition {
  id         String @id @default(uuid())
  workflowId String @map("workflow_id")
  fromNodeId String @map("from_node_id")
  toNodeId   String @map("to_node_id")
  /**
   * Étiquette de la branche (« GO », « NO GO »…) — requise sur un nœud DECISION.
   */
  label      String @default("")

  workflow Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  from     WorkflowNode @relation("TransitionFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  to       WorkflowNode @relation("TransitionTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, label])
  @@index([workflowId])
  @@map("workflow_transitions")
}

/**
 * Exécution d'un workflow sur un projet (moteur de workflow).
 */
model WorkflowRun {
  id            String            @id @default(uuid())
  workflowId    String            @map("workflow_id")
  projectId     String            @map("project_id")
  currentNodeId String?           @map("current_node_id")
  status        WorkflowRunStatus @default(RUNNING)
  startedAt     DateTime          @default(now()) @map("started_at")
  endedAt       DateTime?         @map("ended_at")

  workflow    Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  project     TaskProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentNode WorkflowNode?    @relation(fields: [currentNodeId], references: [id], onDelete: SetNull)
  logs        WorkflowRunLog[]

  @@index([projectId, status])
  @@map("workflow_runs")
}

model WorkflowRunLog {
  id        String   @id @default(uuid())
  runId     String   @map("run_id")
  nodeId    String?  @map("node_id")
  /**
   * Branche empruntée quand le nœud quitté était un DECISION.
   */
  decision  String?
  note      String?  @db.Text
  /**
   * Sous-tâche créée par un nœud SUBTASK.
   */
  taskId    String?  @map("task_id")
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  run   WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  node  WorkflowNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  task  Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@map("workflow_run_logs")
}
