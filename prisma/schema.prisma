generator client {
  provider = "prisma-client-js"
}

// Neon : URL avec pooler pour l’app ; pour `prisma migrate`, ajoutez directUrl (URL non poolée) — voir doc Neon + Prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  learner
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(learner)
  authVersion  Int      @default(0) @map("auth_version")
  /** Accepte les e-mails d’annonces La Forge Hub (formation, webinaires). */
  marketingOptIn Boolean @default(false) @map("marketing_opt_in")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  enrollments          Enrollment[]
  lessonProgress       LessonProgress[]
  posts                CommunityPost[]
  webinarRegistrations WebinarRegistration[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum WebinarKind {
  ARCHIVE
  EVENT
}

enum WebinarLocation {
  ONLINE
  ONSITE
}

/** Replay (ARCHIVE) ou session live à venir (EVENT) */
model Webinar {
  id           String           @id @default(uuid())
  kind         WebinarKind
  title        String
  description  String
  tag          String
  recordingUrl String?          @map("recording_url")
  startsAt     DateTime?        @map("starts_at")
  locationType WebinarLocation? @map("location_type")
  onlineLink   String?          @map("online_link")
  venue        String?
  bannerUrl    String?          @map("banner_url")
  published    Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  registrations WebinarRegistration[]
  replayViews   WebinarReplayView[]

  @@index([kind, startsAt])
  @@index([published])
  @@map("webinars")
}

model WebinarRegistration {
  id           String   @id @default(uuid())
  webinarId    String   @map("webinar_id")
  /** Compte plateforme ; null = inscription invité (email / téléphone / nom). */
  userId       String?  @map("user_id")
  /** E-mail normalisé (minuscule, trim) — clé de dédoublonnage par webinaire. */
  emailKey     String   @map("email_key")
  /** Téléphone WhatsApp (invités) ; optionnel pour comptes liés. */
  guestPhone   String?  @map("guest_phone")
  /** Nom complet (invités). */
  guestName    String?  @map("guest_name")
  /** Consentement e-mails annonces La Forge Hub au moment de l’inscription. */
  marketingOptIn Boolean @default(false) @map("marketing_opt_in")
  registeredAt DateTime @default(now()) @map("registered_at")

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([webinarId, emailKey])
  @@index([webinarId])
  @@map("webinar_registrations")
}

/** Vues uniques d’un replay (comptage interne, anonyme, 1 par navigateur). */
model WebinarReplayView {
  id        String   @id @default(uuid())
  webinarId String   @map("webinar_id")
  viewerKey String   @map("viewer_key")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([webinarId, viewerKey])
  @@index([webinarId, viewedAt(sort: Desc)])
  @@map("webinar_replay_views")
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  courseSlug String   @default("formation-ia") @map("course_slug")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug])
  @@map("enrollments")
}

/** Contacts dédupliqués par e-mail (CRM / annonces Brevo). */
model MarketingContact {
  id             String   @id @default(uuid())
  emailKey       String   @unique @map("email_key")
  displayName    String?  @map("display_name")
  phone          String?
  marketingOptIn Boolean  @default(false) @map("marketing_opt_in")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([marketingOptIn])
  @@map("marketing_contacts")
}

model LessonProgress {
  userId          String   @map("user_id")
  lessonId        String   @map("lesson_id")
  completed       Boolean  @default(false)
  lastPositionSec Int      @default(0) @map("last_position_sec")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

model CommunityPost {
  id        String   @id @default(uuid())
  lessonId  String   @map("lesson_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent CommunityPost? @relation("PostThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityPost[] @relation("PostThread")

  @@index([lessonId, createdAt(sort: Desc)])
  @@map("community_posts")
}

/** Catalogue leçons (vidéos + lien Colab / corrigé) — alimenté par seed ou API admin */
model Lesson {
  lessonId    String    @id @map("lesson_id")
  courseSlug  String    @default("formation-ia") @map("course_slug")
  position    Int
  title       String
  /** Résumé affiché dans le menu des leçons et le catalogue (optionnel) */
  description String?   @db.Text @map("description")
  youtubeId   String    @map("youtube_id")
  tag         String
  collabUrl   String?   @map("collab_url")
  recordedAt  DateTime? @map("recorded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([courseSlug, position])
  @@index([courseSlug])
  @@map("lessons")
}

/* ---------- Attestations NOAI / Bootcamp IOAI ---------- */

enum CertificateKind {
  NOAI
  BOOTCAMP
}

/**
 * Participant NOAI 2026 (liste officielle, chargée par `db:seed:attestations`).
 * Les coordonnées sont vides au départ : elles sont renseignées, puis mises à jour,
 * à chaque demande d'attestation validée depuis /attestations.
 */
model Participant {
  id           String  @id @default(uuid())
  tableNumber  String  @unique @map("table_number")
  lastName     String  @map("last_name")
  firstName    String  @map("first_name")

  /** Renseignés par le participant lors de sa demande. */
  email        String?
  phone        String?
  /** Nom tel qu'il l'a saisi, conservé s'il diffère de la liste officielle. */
  declaredName String? @map("declared_name")

  requestCount  Int       @default(0) @map("request_count")
  firstRequestAt DateTime? @map("first_request_at")
  lastRequestAt  DateTime? @map("last_request_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  certificates Certificate[]

  @@index([email])
  @@map("participants")
}

/** Attestation nominative. Le PDF est rattaché après le seed, par script d'import. */
model Certificate {
  id            String          @id @default(uuid())
  participantId String          @map("participant_id")
  kind          CertificateKind
  fileName      String?         @map("file_name")
  pdf           Bytes?
  /** Aperçu JPEG page 1 (affichage fiable sur mobile, où l'iframe PDF échoue souvent). */
  previewImage  Bytes?          @map("preview_image")
  downloadCount Int             @default(0) @map("download_count")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  participant Participant           @relation(fields: [participantId], references: [id], onDelete: Cascade)
  downloads   CertificateDownload[]

  @@unique([participantId, kind])
  @@map("certificates")
}

/** Journal de toutes les demandes, y compris celles en échec (relance et support). */
model CertificateRequest {
  id           String   @id @default(uuid())
  tableNumber  String   @map("table_number")
  providedName String   @map("provided_name")
  email        String
  phone        String
  /** FOUND | NAME_MISMATCH | NOT_FOUND */
  outcome      String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tableNumber])
  @@index([outcome])
  @@map("certificate_requests")
}

/** Une ligne par téléchargement effectif (le compteur agrégé vit sur Certificate). */
model CertificateDownload {
  id            String   @id @default(uuid())
  certificateId String   @map("certificate_id")
  email         String?
  downloadedAt  DateTime @default(now()) @map("downloaded_at")

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@map("certificate_downloads")
}

/** Fenêtre de limitation des recherches, identifiée par une empreinte réseau anonyme. */
model CertificateRateLimit {
  ipHash          String   @id @map("ip_hash")
  windowStartedAt DateTime @default(now()) @map("window_started_at")
  requestCount    Int      @default(1) @map("request_count")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("certificate_rate_limits")
}
